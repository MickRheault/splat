# ==============================================================================
# SPLAT ENVIRONMENT VARIABLES & CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC ENVIRONMENT VARIABLES (Vite Client Bundle)
# Note: Any variable starting with VITE_ will be bundled into client JS.
# ------------------------------------------------------------------------------

# Production Backend API Base URL
VITE_API_BASE_URL=https://splat-bills.vercel.app

# RevenueCat Public SDK Keys (Optional client-side overrides)
VITE_REVENUECAT_ANDROID_PUBLIC_KEY=goog_sample_key_here
VITE_REVENUECAT_IOS_PUBLIC_KEY=appl_sample_key_here

# ------------------------------------------------------------------------------
# 2. BACKEND SERVERLESS SECRETS (Vercel Node.js Serverless Functions)
# WARNING: DO NOT prefix with VITE_. Keep these strictly on Vercel Dashboard!
# ------------------------------------------------------------------------------

# Google Gemini AI OCR Secret API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Upstash Redis / Vercel KV Database (For Scan Quotas & Rate Limits)
KV_REST_API_URL=https://your-kv-db.upstash.io
KV_REST_API_TOKEN=your_kv_rest_token_here

# RevenueCat Webhook Secret Verification Header
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret_here
