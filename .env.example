# Frontend: VITE_* values are public in the built app. Never put secret keys here.
VITE_API_BASE_URL=https://splat-bills.vercel.app
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ANDROID_API_KEY=
VITE_BILLING_TEST_MODE=false
VITE_ENABLE_DEV_MENU=false

# Server functions (Vercel production environment).
GEMINI_API_KEY=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
KV_REST_API_URL=
KV_REST_API_TOKEN=
BILLING_ENV=production
FREE_SCANS_LIMIT=3
IP_DAILY_FREE_SCANS_LIMIT=20

# Local or dedicated staging only. Never enable these in production.
# BILLING_ENV=local                   # staging on a separate preview project
# BILLING_TEST_MODE=true
# BILLING_TEST_NAMESPACE=local
# BILLING_TEST_KV_REST_API_URL=
# BILLING_TEST_KV_REST_API_TOKEN=
# VITE_BILLING_TEST_MODE=true
# VITE_ENABLE_DEV_MENU=true
# VITE_API_BASE_URL=http://localhost:3000

# Optional local Vite-only direct OCR. This key is exposed to the browser.
# Never set it for any deployed build; use server GEMINI_API_KEY there.
# VITE_GEMINI_API_KEY=
